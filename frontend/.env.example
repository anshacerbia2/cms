# Copy to .env for local development. Vite reads this only at startup, so
# restart `pnpm dev` after any change here.
#
# Both values are optional — without them, api.ts falls back to the relative
# `/api` and vite.config proxies it to http://localhost:3000. That default is
# what breaks on Windows: the API binds 127.0.0.1 (IPv4 only, from the loopback
# fix), while `localhost` resolves to ::1 first, so the proxy connects to
# nothing and every request fails with no visible error. Naming the IPv4 address
# explicitly avoids the guess.

# Where the browser sends API calls. Point it straight at the API and the vite
# proxy is bypassed entirely.
VITE_API_URL=http://127.0.0.1:3000/api

# Used as the vite proxy target when VITE_API_URL is not set.
VITE_BACKEND_URL=http://127.0.0.1:3000
