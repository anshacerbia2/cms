# Copy to .env for local development. Vite reads this only at startup, so
# restart `pnpm dev` after any change here.
#
# Leave VITE_API_URL empty. The session is an HttpOnly cookie with
# SameSite=Strict, so the browser must reach the API on the same origin as the
# page: api.ts then calls the relative `/api`, and vite.config proxies it to
# VITE_BACKEND_URL - the same shape as production, where nginx does the proxying.
# Pointing VITE_API_URL straight at the API makes it another site to the browser
# (localhost and 127.0.0.1 count as different sites): sign-in succeeds, the cookie
# is never sent back, and every following request is a 401.
VITE_API_URL=

# Where the vite proxy forwards /api. Use the IPv4 address, not `localhost`: the
# API binds 127.0.0.1 only, and on Windows `localhost` resolves to ::1 first, so
# the proxy would connect to nothing.
VITE_BACKEND_URL=http://127.0.0.1:3000
