# Render / Production Environment Template
# Copy these keys into your Render Environment Variables dashboard

# 1. Database Connection (Get from Supabase -> Project Settings -> Database -> Connection string -> Transaction)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# 2. Security (Generate a strong random string)
JWT_SECRET="generate-a-very-strong-secret-key-here-for-production"
# Sesi login (cookie HttpOnly). Mati sendiri sesudah SESSION_IDLE_MINUTES tanpa
# aktivitas, dan paling lama SESSION_MAX_HOURS sejak login walau dipakai terus.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Origin yang boleh memanggil API, dipisah koma. Kosong = daftar tetap
# https://pcmi-admin.online (+www), apa pun NODE_ENV-nya (pentest N-07: gagal
# tertutup). Untuk dev, sebut origin Vite di sini, mis. http://localhost:5173.
CORS_ORIGINS=
# Khusus dev: set ke 1 supaya API memantulkan origin pemanggil mana pun (dengan
# credentials). JANGAN diisi di production.
CORS_DEV_REFLECT=

# Kunci enkripsi kredensial Settings > Notification Channels (Telegram, Google Chat).
# 32 byte base64: openssl rand -base64 32. Kalau diganti, kredensial channel harus diisi ulang.
NOTIFICATION_SECRET_KEY=

# 3. Server Configuration (Render handles this automatically, but good to have)
PORT=3000
# Alamat bind API. Biarkan 127.0.0.1: API wajib di belakang nginx, tidak boleh
# diakses langsung lewat HTTP polos (pentest F-05/N-08). Kode membaca APP_HOST
# (atau HOST) dan defaultnya 127.0.0.1.
APP_HOST=127.0.0.1
NODE_ENV=production
# Catatan: JWT_EXPIRES_IN tidak dipakai lagi - umur sesi diatur SessionService
# lewat SESSION_IDLE_MINUTES / SESSION_MAX_HOURS. Hapus kalau masih ada di .env.
