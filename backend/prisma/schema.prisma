generator client {
  provider        = "prisma-client-js"
  // previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// --- AUTH & RBAC ---

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  route       String   @unique @db.VarChar(150)
  method      String?  @db.VarChar(10)
  path        String?  @db.VarChar(255)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles       RolePermission[]
  menus       Menu[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model User {
  id              BigInt     @id @default(autoincrement())
  name            String     @db.VarChar(255)
  email           String     @unique @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  password        String     @db.VarChar(255)
  phone           String?    @db.VarChar(255)
  location        String?    @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  roleId          BigInt?    @map("role_id")
  rememberToken   String?    @map("remember_token") @db.VarChar(100)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  role            Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  fiscalPeriods   FiscalPeriod[] @relation("ClosedBy")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Menu {
  id           BigInt   @id @default(autoincrement())
  parentId     BigInt?  @map("parent_id")
  name         String   @db.VarChar(100)
  icon         String?  @db.VarChar(100)
  permissionId BigInt?  @map("permission_id")
  orderIndex   Int      @default(0) @map("order_index")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent       Menu?    @relation("MenuToMenu", fields: [parentId], references: [id], onDelete: SetNull)
  children     Menu[]   @relation("MenuToMenu")
  permission   Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  roles        RoleMenu[]

  @@map("menus")
}

model RoleMenu {
  id        BigInt   @id @default(autoincrement())
  roleId    BigInt   @map("role_id")
  menuId    BigInt   @map("menu_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@map("role_menu")
}

// --- MASTER DATA: CUSTOMERS ---

model Customer {
  id                BigInt          @id @default(autoincrement())
  code              String          @unique @db.VarChar(255)
  name              String          @db.VarChar(255)
  bankName          String?         @map("bank_name") @db.VarChar(255)
  bankAccountNumber String?         @map("bank_account_number") @db.VarChar(255)
  bankAccountName   String?         @map("bank_account_name") @db.VarChar(255)
  status            CustomerStatus  @default(ACTIVE)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  billingOptions    BillingOption[]
  pics              CustomerPic[]

  @@index([name])
  @@index([status])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model BillingOption {
  id             BigInt    @id @default(autoincrement())
  customerId     BigInt    @map("customer_id")
  cpName         String?   @map("cp_name") @db.VarChar(255)
  cpTitleDivision String?  @map("cp_title_division") @db.VarChar(255)
  cpEmail        String?   @map("cp_email") @db.VarChar(255)
  cpOfficeNumber String?   @map("cp_office_number") @db.VarChar(255)
  cpMobileNumber String?   @map("cp_mobile_number") @db.VarChar(255)
  isOverseas     Boolean   @default(false) @map("is_overseas")
  address        String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("billing_options")
}

model CustomerPic {
  id         BigInt         @id @default(autoincrement())
  customerId BigInt         @map("customer_id")
  name       String         @db.VarChar(255)
  email      String?        @db.VarChar(255)
  phone      String?        @db.VarChar(255)
  position   String?        @db.VarChar(255)
  status     PicStatus      @default(ACTIVE)
  notes      String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([name])
  @@index([status])
  @@map("customer_pics")
}

enum PicStatus {
  ACTIVE
  INACTIVE
}

// --- MASTER DATA: SUPPLIERS ---

model Supplier {
  id                BigInt          @id @default(autoincrement())
  code              String          @unique @db.VarChar(255)
  name              String          @db.VarChar(255)
  address           String?         @db.Text
  contactPerson     String?         @map("contact_person") @db.VarChar(255)
  phone             String?         @db.VarChar(255)
  email             String?         @db.VarChar(255)
  taxNumber         String?         @map("tax_number") @db.VarChar(255)
  bankName          String?         @map("bank_name") @db.VarChar(255)
  bankAccountNumber String?         @map("bank_account_number") @db.VarChar(255)
  bankAccountName   String?         @map("bank_account_name") @db.VarChar(255)
  status            SupplierStatus  @default(ACTIVE)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  pics              SupplierPic[]
  products          Product[]

  @@index([name])
  @@index([status])
  @@map("suppliers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model SupplierPic {
  id         BigInt         @id @default(autoincrement())
  supplierId BigInt         @map("supplier_id")
  name       String         @db.VarChar(255)
  email      String?        @db.VarChar(255)
  phone      String?        @db.VarChar(255)
  position   String?        @db.VarChar(255)
  status     PicStatus      @default(ACTIVE)
  notes      String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  supplier   Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([name])
  @@index([status])
  @@map("supplier_pics")
}

// --- MASTER DATA: PRODUCTS ---

model ProductCategory {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(255)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("product_categories")
}

model Product {
  id          BigInt          @id @default(autoincrement())
  code        String          @unique @db.VarChar(255)
  name        String          @db.VarChar(255)
  description String?         @db.Text
  unit        String          @db.VarChar(50)
  categoryId  BigInt?         @map("category_id")
  supplierId  BigInt?         @map("supplier_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([code])
  @@map("products")
}

// --- MASTER DATA: BANKS ---

model Bank {
  id          BigInt            @id @default(autoincrement())
  bankCode    String            @unique @map("bank_code") @db.Char(3)
  bankName    String            @map("bank_name") @db.VarChar(255)
  bankBrand   String            @map("bank_brand") @db.VarChar(50)
  bankAddress String?           @map("bank_address") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  internalAccounts InternalAccount[]

  @@index([bankBrand])
  @@map("banks")
}

model InternalAccount {
  id          BigInt               @id @default(autoincrement())
  bankId      BigInt?              @map("bank_id")
  userId      BigInt?              @map("user_id") // Links to owner/responsible user
  type        InternalAccountType  @default(BANK)
  accountNo   String?              @map("account_no") @db.VarChar(50)
  branch      String?              @db.VarChar(255)
  swiftCode   String?              @map("swift_code") @db.VarChar(20)
  holderName  String               @map("holder_name") @db.VarChar(255)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  bank        Bank?                @relation(fields: [bankId], references: [id], onDelete: Restrict)
  fiscalPeriods   FiscalPeriod[]
  transactions    FinancialTransaction[]

  @@unique([accountNo, type, holderName, branch])
  @@map("internal_accounts")
}

model FiscalPeriod {
  id                BigInt          @id @default(autoincrement())
  internalAccountId BigInt          @map("internal_account_id")
  year              Int
  openingBalance    Decimal         @default(0) @db.Decimal(19, 4) @map("opening_balance")
  closingBalance    Decimal?        @db.Decimal(19, 4) @map("closing_balance") // Audited Snapshot
  status            FiscalStatus    @default(OPEN)
  isStale           Boolean         @default(false) @map("is_stale")
  closedAt          DateTime?       @map("closed_at")
  closedById        BigInt?         @map("closed_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  internalAccount   InternalAccount @relation(fields: [internalAccountId], references: [id], onDelete: Cascade)
  closedBy          User?           @relation("ClosedBy", fields: [closedById], references: [id])

  @@unique([internalAccountId, year])
  @@map("fiscal_periods")
}

enum FiscalStatus {
  OPEN
  ONGOING
  CLOSED
}

enum InternalAccountType {
  BANK
  CASH
  OTHER
}


// --- FINANCIAL DATA: CONSOLIDATED BANK LEDGER ---

model FinancialTransaction {
  id                BigInt   @id @default(autoincrement())
  internalAccountId BigInt?  @map("internal_account_id")
  colA              DateTime? @map("col_a") // Date
  colB              String?   @map("col_b") @db.Text // Description
  colC              Decimal?  @default(0) @map("col_c") @db.Decimal(19, 4) // Debit
  colD              Decimal?  @default(0) @map("col_d") @db.Decimal(19, 4) // Credit
  colE              Decimal?  @default(0) @map("col_e") @db.Decimal(19, 4) // Balance
  colF              String?   @map("col_f") @db.Text // Ledger
  colG              String?   @map("col_g") @db.Text // Sub Ledger 1
  colH              String?   @map("col_h") @db.Text // Sub Ledger 2
  colI              String?   @map("col_i") @db.Text // Sub Ledger 3
  colJ              String?   @map("col_j") @db.Text // Sub Ledger 4
  colK              String?   @map("col_k") @db.Text // Sub Ledger 5
  colL              String?   @map("col_l") @db.Text // Sub Ledger 6
  colM              String?   @map("col_m") @db.Text // Sub Ledger 7
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  internalAccount   InternalAccount? @relation(fields: [internalAccountId], references: [id])

  @@map("financial_transactions")
}

// --- FINANCIAL DATA: SALES & REVENUE ---

model SalesRecord {
  id              BigInt   @id @default(autoincrement())
  colA            String?  @db.VarChar(100)
  colB            String?  @db.VarChar(100)
  colC            DateTime?
  colD            Int?
  colE            String?  @db.Text
  colF            String?  @db.Text
  colG            String?  @db.Text
  colH            Decimal? @db.Decimal(19, 4)
  colI            Decimal? @db.Decimal(19, 4)
  colJ            Decimal? @db.Decimal(19, 4)
  colK            Decimal? @db.Decimal(19, 4)
  colL            DateTime?
  colM            Decimal? @db.Decimal(19, 4)
  colN            Decimal? @db.Decimal(19, 4)
  colO            Decimal? @db.Decimal(19, 4)
  colP            Decimal? @db.Decimal(19, 4)
  colQ            Decimal? @db.Decimal(19, 4)
  colR            Decimal? @db.Decimal(19, 4)
  colS            Decimal? @db.Decimal(19, 4)
  colT            Decimal? @db.Decimal(19, 4)
  colU            Decimal? @db.Decimal(19, 4)
  colV            Decimal? @db.Decimal(19, 4)
  colW            Decimal? @db.Decimal(19, 4)
  colX            Decimal? @db.Decimal(19, 4)
  colY            String?  @db.Text
  colZ            Decimal? @db.Decimal(19, 4)
  colAA           Decimal? @db.Decimal(19, 4)
  colAB           Decimal? @db.Decimal(19, 4)
  colAC           Decimal? @db.Decimal(19, 4)
  colAD           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sales_records")
}

model AccountReceivable {
  id              BigInt   @id @default(autoincrement())
  colA            String?  @db.VarChar(100)
  colB            String?  @db.VarChar(100)
  colC            String?  @db.Text
  colD            String?  @db.Text
  colE            String?  @db.Text
  colF            Decimal? @db.Decimal(19, 4)
  colG            Decimal? @db.Decimal(19, 4)
  colH            Decimal? @db.Decimal(19, 4)
  colI            String?  @db.Text
  colJ            Decimal? @db.Decimal(19, 4)
  colK            Decimal? @db.Decimal(19, 4)
  colL            Decimal? @db.Decimal(19, 4)
  colM            Decimal? @db.Decimal(19, 4)
  colN            Decimal? @db.Decimal(19, 4)
  colO            Decimal? @db.Decimal(19, 4)
  colP            Decimal? @db.Decimal(19, 4)
  colQ            String?  @db.Text
  colR            Decimal? @db.Decimal(19, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("account_receivables")
}

model AccountPayable {
  id              BigInt   @id @default(autoincrement())
  colA            String?  @db.VarChar(100)
  colB            Int?
  colC            String?  @db.Text
  colD            String?  @db.Text
  colE            Decimal? @db.Decimal(19, 4)
  colF            String?  @db.Text
  colG            String?  @db.Text
  colH            String?  @db.Text
  colI            Decimal? @db.Decimal(19, 4)
  colJ            Decimal? @db.Decimal(19, 4)
  colK            Decimal? @db.Decimal(19, 4)
  colL            Decimal? @db.Decimal(19, 4)
  colM            Decimal? @db.Decimal(19, 4)
  colN            Decimal? @db.Decimal(19, 4)
  colO            Decimal? @db.Decimal(19, 4)
  colP            Decimal? @db.Decimal(19, 4)
  colQ            Decimal? @db.Decimal(19, 4)
  colR            String?  @db.Text
  colS            Decimal? @db.Decimal(19, 4)
  colT            Decimal? @db.Decimal(19, 4)
  colU            Decimal? @db.Decimal(19, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("account_payables")
}

enum PpnType {
  WAPU
  NON_WAPU
}

enum DepreciationType {
  OFFICE_EQUIPMENT
  VEHICLE
  INTANGIBLE_ASSET
}

model TaxLedger {
  id              BigInt      @id @default(autoincrement())
  type            PpnType
  colA            DateTime?   @db.Date        // Masa
  colB            String?     @db.VarChar(100) // Faktur
  colC            String?     @db.VarChar(100) // No Faktur
  colD            String?     @db.Text         // Client / Supplier
  colE            String?     @db.VarChar(255) // Reference
  colF            Int?                         // Year
  colG            String?     @db.VarChar(100) // STATUS
  colH            Decimal?    @db.Decimal(19, 4) // PPN
  colI            Decimal?    @db.Decimal(19, 4) // Amount (Wapu/Non-Wapu)
  colJ            Decimal?    @db.Decimal(19, 4) // Masukan
  colK            Decimal?    @db.Decimal(19, 4) // Kurang Bayar
  colL            String?     @db.VarChar(255) // Account
  colM            String?     @db.VarChar(255) // Sub Ledger 1
  colN            String?     @db.VarChar(255) // Sub Ledger 2
  colO            String?     @db.VarChar(255) // Sub Ledger 3
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("tax_ledgers")
}

// --- FINANCIAL DATA: ASSETS & DEPRECIATION ---

model Depreciation {
  id              BigInt   @id @default(autoincrement())
  colA            DateTime? @map("col_a")
  colB            String?   @map("col_b") @db.VarChar(100)
  colC            String?   @map("col_c") @db.Text
  colD            Decimal?  @default(0) @map("col_d") @db.Decimal(19, 4)
  colE            Int?      @map("col_e")
  colF            Decimal?  @default(0) @map("col_f") @db.Decimal(19, 4)
  colG            Decimal?  @default(0) @map("col_g") @db.Decimal(19, 4)
  colH            Decimal?  @default(0) @map("col_h") @db.Decimal(19, 4)
  colI            Decimal?  @default(0) @map("col_i") @db.Decimal(19, 4)
  colJ            Decimal?  @default(0) @map("col_j") @db.Decimal(19, 4)
  colK            Decimal?  @default(0) @map("col_k") @db.Decimal(19, 4)
  colL            Decimal?  @default(0) @map("col_l") @db.Decimal(19, 4)
  colM            Decimal?  @default(0) @map("col_m") @db.Decimal(19, 4)
  colN            Decimal?  @default(0) @map("col_n") @db.Decimal(19, 4)
  colO            Decimal?  @default(0) @map("col_o") @db.Decimal(19, 4)
  colP            Decimal?  @default(0) @map("col_p") @db.Decimal(19, 4)
  colQ            Decimal?  @default(0) @map("col_q") @db.Decimal(19, 4)
  colR            Decimal?  @default(0) @map("col_r") @db.Decimal(19, 4)
  colS            Decimal?  @default(0) @map("col_s") @db.Decimal(19, 4)
  colT            Decimal?  @default(0) @map("col_t") @db.Decimal(19, 4)
  colU            Decimal?  @default(0) @map("col_u") @db.Decimal(19, 4)
  type            DepreciationType @default(OFFICE_EQUIPMENT)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("depreciation")
}

// --- FINANCIAL DATA: PROFIT & LOSS ---
model FinanceRevenue {
  id        BigInt   @id @default(autoincrement())
  colA      String?  @db.VarChar(50)
  colB      String?  @db.VarChar(100)
  colC      String?  @db.Text
  colD      Decimal  @default(0) @db.Decimal(19, 4)
  colE      Decimal  @default(0) @db.Decimal(19, 4)
  colF      Decimal  @default(0) @db.Decimal(19, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("finance_revenue")
}

model FinanceExpense {
  id        BigInt    @id @default(autoincrement())
  colA      String?   @db.VarChar(100)
  colB      DateTime? @db.Date
  colC      String?   @db.Text
  colD      Decimal   @default(0) @db.Decimal(19, 4)
  colE      Decimal   @default(0) @db.Decimal(19, 4)
  colF      Decimal   @default(0) @db.Decimal(19, 4)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("finance_expenses")
}

model ProfitLossSummary {
  id          BigInt   @id @default(autoincrement())
  category    String?  @db.VarChar(100)
  bca         Decimal  @default(0) @db.Decimal(19, 4)
  mandiri     Decimal  @default(0) @db.Decimal(19, 4)
  bri         Decimal  @default(0) @db.Decimal(19, 4)
  btn         Decimal  @default(0) @db.Decimal(19, 4)
  cashIdr     Decimal  @default(0) @map("cash_idr") @db.Decimal(19, 4)
  nonCb       Decimal  @default(0) @map("non_cb") @db.Decimal(19, 4)
  other       Decimal  @default(0) @db.Decimal(19, 4)
  total       Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profit_loss_summary")
}

// --- FINANCIAL DATA: BALANCE SHEET ---

model BalanceSheetItem {
  id          BigInt   @id @default(autoincrement())
  category    String?  @db.VarChar(100)
  accountName String?  @map("account_name") @db.VarChar(255)
  idr         Decimal  @default(0) @db.Decimal(19, 4)
  usd         Decimal  @default(0) @db.Decimal(19, 4)
  rate        Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("balance_sheet_items")
}

// --- FINANCIAL DATA: INTER-ACCOUNT TRANSFERS ---

model InterAccountTransfer {
  id          BigInt   @id @default(autoincrement())
  date        String?  @db.VarChar(50)
  description String?  @db.Text
  bca         Decimal  @default(0) @db.Decimal(19, 4)
  mandiri     Decimal  @default(0) @db.Decimal(19, 4)
  bri         Decimal  @default(0) @db.Decimal(19, 4)
  btn         Decimal  @default(0) @db.Decimal(19, 4)
  cashIdr     Decimal  @default(0) @map("cash_idr") @db.Decimal(19, 4)
  nonCashBank Decimal  @default(0) @map("non_cash_bank") @db.Decimal(19, 4)
  checker     Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("inter_account_transfers")
}
