// --- FINANCIAL DATA: ASSETS & DEPRECIATION ---

model AssetDepreciation {
  id              BigInt   @id @default(autoincrement())
  purchaseDate    String?  @map("purchase_date") @db.VarChar(50)
  bankRef         String?  @map("bank_ref") @db.VarChar(100)
  assetName       String?  @map("asset_name") @db.VarChar(255)
  purchasePrice   Decimal  @default(0) @map("purchase_price") @db.Decimal(19, 4)
  usefulLife      Int?     @map("useful_life")
  accumulated2020 Decimal  @default(0) @map("accumulated_2020") @db.Decimal(19, 4)
  jan             Decimal  @default(0) @db.Decimal(19, 4)
  feb             Decimal  @default(0) @db.Decimal(19, 4)
  mar             Decimal  @default(0) @db.Decimal(19, 4)
  apr             Decimal  @default(0) @db.Decimal(19, 4)
  may              Decimal  @default(0) @db.Decimal(19, 4)
  jun              Decimal  @default(0) @db.Decimal(19, 4)
  jul              Decimal  @default(0) @db.Decimal(19, 4)
  aug              Decimal  @default(0) @db.Decimal(19, 4)
  sep              Decimal  @default(0) @db.Decimal(19, 4)
  oct              Decimal  @default(0) @db.Decimal(19, 4)
  nov              Decimal  @default(0) @db.Decimal(19, 4)
  dec              Decimal  @default(0) @db.Decimal(19, 4)
  total2021       Decimal  @default(0) @map("total_2021") @db.Decimal(19, 4)
  accumulated2021 Decimal  @default(0) @map("accumulated_2021") @db.Decimal(19, 4)
  bookValue       Decimal  @default(0) @map("book_value") @db.Decimal(19, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("asset_depreciation")
}

// --- FINANCIAL DATA: PROFIT & LOSS ---

model ProfitLossSales {
  id          BigInt   @id @default(autoincrement())
  accountName String?  @map("account_name") @db.VarChar(255)
  gross       Decimal  @default(0) @db.Decimal(19, 4)
  vat         Decimal  @default(0) @db.Decimal(19, 4)
  apVat       Decimal  @default(0) @map("ap_vat") @db.Decimal(19, 4)
  creditNote  Decimal  @default(0) @map("credit_note") @db.Decimal(19, 4)
  apCreditNote Decimal  @default(0) @map("ap_credit_note") @db.Decimal(19, 4)
  netSales    Decimal  @default(0) @map("net_sales") @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profit_loss_sales")
}

model ProfitLossCost {
  id          BigInt   @id @default(autoincrement())
  category    String?  @db.VarChar(100)
  subCategory String?  @map("sub_category") @db.VarChar(100)
  accountName String?  @map("account_name") @db.VarChar(255)
  bca         Decimal  @default(0) @db.Decimal(19, 4)
  mandiri     Decimal  @default(0) @db.Decimal(19, 4)
  bri         Decimal  @default(0) @db.Decimal(19, 4)
  btn         Decimal  @default(0) @db.Decimal(19, 4)
  cashIdr     Decimal  @default(0) @map("cash_idr") @db.Decimal(19, 4)
  nonCb       Decimal  @default(0) @map("non_cb") @db.Decimal(19, 4)
  other       Decimal  @default(0) @db.Decimal(19, 4)
  total       Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profit_loss_costs")
}

model ProfitLossSummary {
  id          BigInt   @id @default(autoincrement())
  category    String?  @db.VarChar(100)
  bca         Decimal  @default(0) @db.Decimal(19, 4)
  mandiri     Decimal  @default(0) @db.Decimal(19, 4)
  bri         Decimal  @default(0) @db.Decimal(19, 4)
  btn         Decimal  @default(0) @db.Decimal(19, 4)
  cashIdr     Decimal  @default(0) @map("cash_idr") @db.Decimal(19, 4)
  nonCb       Decimal  @default(0) @map("non_cb") @db.Decimal(19, 4)
  other       Decimal  @default(0) @db.Decimal(19, 4)
  total       Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profit_loss_summary")
}

// --- FINANCIAL DATA: BALANCE SHEET ---

model BalanceSheetItem {
  id          BigInt   @id @default(autoincrement())
  category    String?  @db.VarChar(100)
  accountName String?  @map("account_name") @db.VarChar(255)
  idr         Decimal  @default(0) @db.Decimal(19, 4)
  usd         Decimal  @default(0) @db.Decimal(19, 4)
  rate        Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("balance_sheet_items")
}

// --- FINANCIAL DATA: INTER-ACCOUNT TRANSFERS ---

model InterAccountTransfer {
  id          BigInt   @id @default(autoincrement())
  date        String?  @db.VarChar(50)
  description String?  @db.Text
  bca         Decimal  @default(0) @db.Decimal(19, 4)
  mandiri     Decimal  @default(0) @db.Decimal(19, 4)
  bri         Decimal  @default(0) @db.Decimal(19, 4)
  btn         Decimal  @default(0) @db.Decimal(19, 4)
  cashIdr     Decimal  @default(0) @map("cash_idr") @db.Decimal(19, 4)
  nonCashBank Decimal  @default(0) @map("non_cash_bank") @db.Decimal(19, 4)
  checker     Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("inter_account_transfers")
}
