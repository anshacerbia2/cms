  apPpn           Decimal  @default(0) @map("ap_ppn") @db.Decimal(19, 4)
  netReceived     Decimal  @default(0) @map("net_received") @db.Decimal(19, 4)
  col27           String?  @db.VarChar(255)
  col28           String?  @db.VarChar(255)
