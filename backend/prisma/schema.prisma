generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// --- AUTH & RBAC ---

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  route       String   @unique @db.VarChar(150)
  method      String?  @db.VarChar(10)
  path        String?  @db.VarChar(255)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]
  menus Menu[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model User {
  id              BigInt     @id @default(autoincrement())
  name            String     @db.VarChar(255)
  email           String     @unique @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  password        String     @db.VarChar(255)
  phone           String?    @db.VarChar(255)
  location        String?    @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  roleId          BigInt?    @map("role_id")
  rememberToken   String?    @map("remember_token") @db.VarChar(100)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  role          Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  fiscalPeriods FiscalPeriod[] @relation("ClosedBy")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Menu {
  id           BigInt   @id @default(autoincrement())
  parentId     BigInt?  @map("parent_id")
  name         String   @db.VarChar(100)
  icon         String?  @db.VarChar(100)
  permissionId BigInt?  @map("permission_id")
  orderIndex   Int      @default(0) @map("order_index")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent     Menu?       @relation("MenuToMenu", fields: [parentId], references: [id], onDelete: SetNull)
  children   Menu[]      @relation("MenuToMenu")
  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  roles      RoleMenu[]

  @@map("menus")
}

model RoleMenu {
  id        BigInt   @id @default(autoincrement())
  roleId    BigInt   @map("role_id")
  menuId    BigInt   @map("menu_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@map("role_menu")
}

// --- MASTER DATA: CUSTOMERS ---

model Customer {
  id                BigInt         @id @default(autoincrement())
  code              String         @unique @db.VarChar(255)
  name              String         @db.VarChar(255)
  bankName          String?        @map("bank_name") @db.VarChar(255)
  bankAccountNumber String?        @map("bank_account_number") @db.VarChar(255)
  bankAccountName   String?        @map("bank_account_name") @db.VarChar(255)
  status            CustomerStatus @default(ACTIVE)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  billingOptions BillingOption[]
  pics           CustomerPic[]
  projects       Project[]
  invoices       Invoice[]

  @@index([name])
  @@index([status])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model BillingOption {
  id              BigInt    @id @default(autoincrement())
  customerId      BigInt    @map("customer_id")
  cpName          String?   @map("cp_name") @db.VarChar(255)
  cpTitleDivision String?   @map("cp_title_division") @db.VarChar(255)
  cpEmail         String?   @map("cp_email") @db.VarChar(255)
  cpOfficeNumber  String?   @map("cp_office_number") @db.VarChar(255)
  cpMobileNumber  String?   @map("cp_mobile_number") @db.VarChar(255)
  isOverseas      Boolean   @default(false) @map("is_overseas")
  address         String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([customerId])
  @@map("billing_options")
}

model CustomerPic {
  id         BigInt    @id @default(autoincrement())
  customerId BigInt    @map("customer_id")
  name       String    @db.VarChar(255)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(255)
  position   String?   @db.VarChar(255)
  status     PicStatus @default(ACTIVE)
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([name])
  @@index([status])
  @@map("customer_pics")
}

enum PicStatus {
  ACTIVE
  INACTIVE
}

// --- MASTER DATA: SUPPLIERS ---

model Supplier {
  id                BigInt         @id @default(autoincrement())
  code              String         @unique @db.VarChar(255)
  name              String         @db.VarChar(255)
  address           String?        @db.Text
  contactPerson     String?        @map("contact_person") @db.VarChar(255)
  phone             String?        @db.VarChar(255)
  email             String?        @db.VarChar(255)
  taxNumber         String?        @map("tax_number") @db.VarChar(255)
  bankName          String?        @map("bank_name") @db.VarChar(255)
  bankAccountNumber String?        @map("bank_account_number") @db.VarChar(255)
  bankAccountName   String?        @map("bank_account_name") @db.VarChar(255)
  status            SupplierStatus @default(ACTIVE)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  pics     SupplierPic[]
  products Product[]

  @@index([name])
  @@index([status])
  @@map("suppliers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model SupplierPic {
  id         BigInt    @id @default(autoincrement())
  supplierId BigInt    @map("supplier_id")
  name       String    @db.VarChar(255)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(255)
  position   String?   @db.VarChar(255)
  status     PicStatus @default(ACTIVE)
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([name])
  @@index([status])
  @@map("supplier_pics")
}

// --- MASTER DATA: PRODUCTS ---

model ProductCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @db.VarChar(255)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  unit        String    @db.VarChar(50)
  categoryId  BigInt?   @map("category_id")
  supplierId  BigInt?   @map("supplier_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category      ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier      Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  priceVersions ProductPriceVersion[]
  boqItems      BoqItem[]
  salesItems    SalesItem[]

  @@index([name])
  @@index([code])
  @@map("products")
}

// --- MASTER DATA: BANKS ---

model Bank {
  id          BigInt   @id @default(autoincrement())
  bankCode    String   @unique @map("bank_code") @db.Char(3)
  bankName    String   @map("bank_name") @db.VarChar(255)
  bankBrand   String   @map("bank_brand") @db.VarChar(50)
  bankAddress String?  @map("bank_address") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  internalAccounts InternalAccount[]

  @@index([bankBrand])
  @@map("banks")
}

model InternalAccount {
  id                 BigInt              @id @default(autoincrement())
  bankId             BigInt?             @map("bank_id")
  userId             BigInt?             @map("user_id") // Links to owner/responsible user
  type               InternalAccountType @default(BANK)
  accountNo          String?             @map("account_no") @db.VarChar(50)
  branch             String?             @db.VarChar(255)
  swiftCode          String?             @map("swift_code") @db.VarChar(20)
  holderName         String              @map("holder_name") @db.VarChar(255)
  /// What the finance tables call this account in a column header. Derived
  /// names do not work: the holder of BCA Sahardjo is a person, and the cash
  /// and control accounts have no bank to take a name from.
  displayName        String?             @map("display_name") @db.VarChar(100)
  /// Left-to-right position wherever accounts are shown side by side.
  displayOrder       Int?                @map("display_order")
  /// Settlement account for No Tax invoices. The rule was previously carried by a
  /// hardcoded account number, which broke the moment the account changed.
  isNonVatSettlement Boolean             @default(false) @map("is_non_vat_settlement")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  bank                     Bank?                     @relation(fields: [bankId], references: [id], onDelete: Restrict)
  fiscalPeriods            FiscalPeriod[]
  transactions             FinancialTransaction[]
  invoices                 Invoice[]
  receiveVouchers          ReceiveVoucher[]
  paymentVouchers          PaymentVoucher[]
  interAccountAmounts      InterAccountAmount[]
  salesRecordAmounts       SalesRecordAmount[]
  accountReceivableAmounts AccountReceivableAmount[]
  accountPayableAmounts    AccountPayableAmount[]

  @@unique([accountNo, type, holderName, branch])
  @@map("internal_accounts")
}

model FiscalPeriod {
  id                BigInt       @id @default(autoincrement())
  internalAccountId BigInt       @map("internal_account_id")
  year              Int
  openingBalance    Decimal      @default(0) @map("opening_balance") @db.Decimal(19, 4)
  closingBalance    Decimal?     @map("closing_balance") @db.Decimal(19, 4) // Audited Snapshot
  status            FiscalStatus @default(OPEN)
  isStale           Boolean      @default(false) @map("is_stale")
  closedAt          DateTime?    @map("closed_at")
  closedById        BigInt?      @map("closed_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  internalAccount InternalAccount @relation(fields: [internalAccountId], references: [id], onDelete: Cascade)
  closedBy        User?           @relation("ClosedBy", fields: [closedById], references: [id])

  @@unique([internalAccountId, year])
  @@map("fiscal_periods")
}

enum FiscalStatus {
  OPEN
  ONGOING
  CLOSED
}

enum InternalAccountType {
  BANK
  CASH
  OTHER
}

// --- FINANCIAL DATA: CONSOLIDATED BANK LEDGER ---

model FinancialTransaction {
  id                BigInt    @id @default(autoincrement())
  internalAccountId BigInt?   @map("internal_account_id")
  colA              DateTime? @map("col_a") // Date
  colB              String?   @map("col_b") @db.Text // Description
  colC              Decimal?  @default(0) @map("col_c") @db.Decimal(19, 4) // Debit
  colD              Decimal?  @default(0) @map("col_d") @db.Decimal(19, 4) // Credit
  colE              Decimal?  @default(0) @map("col_e") @db.Decimal(19, 4) // Balance
  colF              String?   @map("col_f") @db.Text // Ledger
  colG              String?   @map("col_g") @db.Text // Sub Ledger 1
  colH              String?   @map("col_h") @db.Text // Sub Ledger 2
  colI              String?   @map("col_i") @db.Text // Sub Ledger 3
  tagYear           Int
  /// Posisi baris di dalam ledger satu rekening-tahun, diisi berjarak 1000 supaya
  /// ada ruang menyisip di antaranya. Urutan ledger memang bermakna: ia mengikuti
  /// urutan baris workbook, dan kolom saldo dirantai menuruti urutan itu. Dulu
  /// urutan ini cuma menumpang pada `id`, jadi baris baru selalu mendarat paling
  /// bawah. Dibaca selalu sebagai [{ rowNo: 'asc' }, { id: 'asc' }] - `id` jadi
  /// pemecah seri kalau dua orang menyisip di titik yang sama.
  rowNo             Int?      @map("row_no")
  /// Siapa yang menaruh baris ini: 'SEED' kalau dimuat dari workbook, 'APP'
  /// kalau diinput lewat aplikasi. Seeder hanya menghapus barisnya sendiri,
  /// jadi baris yang diketik orang selamat saat seed ulang tanpa perlu dicatat
  /// di mana pun. Defaultnya 'APP' dengan sengaja: kalau suatu seeder lupa
  /// menandai, akibatnya baris tertinggal - bukan baris user ikut terhapus.
  source            String    @default("APP")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  internalAccount InternalAccount? @relation(fields: [internalAccountId], references: [id])

  @@index([internalAccountId, tagYear, rowNo])
  @@map("financial_transactions")
}

// --- FINANCIAL DATA: SALES & REVENUE ---

model SalesRecord {
  id        BigInt    @id @default(autoincrement())
  colA      String?   @db.VarChar(100) // No
  colB      String?   @db.VarChar(100) // Invoice No
  colC      DateTime? // Date
  colD      Int? // Year
  colE      String?   @db.Text // Billing To
  colF      String?   @db.Text // Sales Code
  colG      String?   @db.Text // Description
  colH      Decimal?  @db.Decimal(19, 4) // Basic Price
  colI      Decimal?  @db.Decimal(19, 4) // Management Fee
  colJ      Decimal?  @db.Decimal(19, 4) // PPN
  colK      Decimal?  @db.Decimal(19, 4) // Account Receivable IDR
  colL      DateTime? // Date Received
  colM      Decimal?  @db.Decimal(19, 4) // BCA Sahardjo
  colN      Decimal?  @db.Decimal(19, 4) // BCA Juanda
  colO      Decimal?  @db.Decimal(19, 4) // Mandiri Mid Plaza
  colP      Decimal?  @db.Decimal(19, 4) // Mandiri Plaza Mandiri
  colQ      Decimal?  @db.Decimal(19, 4) // BRI Tebet
  colR      Decimal?  @db.Decimal(19, 4) // BRI Sahardjo
  colS      Decimal?  @db.Decimal(19, 4) // BTN
  colT      Decimal?  @db.Decimal(19, 4) // Bank Raya
  colU      Decimal?  @db.Decimal(19, 4) // BNI
  colV      Decimal?  @db.Decimal(19, 4) // Cash IDR
  colW      Decimal?  @db.Decimal(19, 4) // Non CB
  colX      Decimal?  @db.Decimal(19, 4) // Outstanding IDR
  colY      String?   @db.Text // Blank
  colZ      Decimal?  @db.Decimal(19, 4) // AP PPn
  colAA     Decimal?  @db.Decimal(19, 4) // PPh-23
  colAB     Decimal?  @db.Decimal(19, 4) // WAPU
  colAC     Decimal?  @db.Decimal(19, 4) // Non WAPU
  colAD     String?   @db.Text // Remarks
  tagYear   Int // Tag Year
  /// Siapa yang menaruh baris ini: 'SEED' kalau dimuat dari workbook, 'APP'
  /// kalau diinput lewat aplikasi. Seeder hanya menghapus barisnya sendiri,
  /// jadi baris yang diketik orang selamat saat seed ulang tanpa perlu dicatat
  /// di mana pun. Defaultnya 'APP' dengan sengaja: kalau suatu seeder lupa
  /// menandai, akibatnya baris tertinggal - bukan baris user ikut terhapus.
  source            String    @default("APP")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  amounts SalesRecordAmount[]

  @@map("sales_records")
}

model AccountReceivable {
  id        BigInt   @id @default(autoincrement())
  colA      String?  @db.VarChar(100) // Blank
  colB      String?  @db.VarChar(100) // Receiveable
  colC      String?  @db.Text // Year
  colD      String?  @db.Text // col D (Subject)
  colE      String?  @db.Text // Description
  colF      Decimal? @db.Decimal(19, 4) // EOY IDR
  colG      Decimal? @db.Decimal(19, 4) // EOY USD
  colH      Decimal? @db.Decimal(19, 4) // col H (USD Rate)
  colI      String?  @db.Text // col I (Blank)
  colJ      Decimal? @db.Decimal(19, 4) // BCA Shardjo
  colK      Decimal? @db.Decimal(19, 4) // BCA Juanda
  colL      Decimal? @db.Decimal(19, 4) // Mandiri Mid Plaza
  colM      Decimal? @db.Decimal(19, 4) // BRI Shardjo
  colN      Decimal? @db.Decimal(19, 4) // Cash IDR
  colO      Decimal? @db.Decimal(19, 4) // Non CB
  colP      Decimal? @db.Decimal(19, 4) // PPn In/Out
  colQ      String?  @db.Text // col Q (Blank)
  colR      Decimal? @db.Decimal(19, 4) // Outstanding IDR
  colS      Decimal? @db.Decimal(19, 4) // Outstanding USD
  tagYear   Int
  /// Siapa yang menaruh baris ini: 'SEED' kalau dimuat dari workbook, 'APP'
  /// kalau diinput lewat aplikasi. Seeder hanya menghapus barisnya sendiri,
  /// jadi baris yang diketik orang selamat saat seed ulang tanpa perlu dicatat
  /// di mana pun. Defaultnya 'APP' dengan sengaja: kalau suatu seeder lupa
  /// menandai, akibatnya baris tertinggal - bukan baris user ikut terhapus.
  source            String    @default("APP")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  amounts AccountReceivableAmount[]

  @@map("account_receivables")
}

model AccountPayable {
  id        BigInt   @id @default(autoincrement())
  colA      String?  @db.VarChar(100) // Payable (Supplier, Deposit) 
  colB      Int? // Year
  colC      String?  @db.Text // Vendor
  colD      String?  @db.Text // Description
  colE      Decimal? @db.Decimal(19, 4) // EOY IDR
  colF      Decimal? @db.Decimal(19, 4) // EOY USD
  colG      Decimal? @db.Decimal(19, 4) // col G (USD Rate)
  colH      String?  @db.Text // col H
  colI      String?  @db.Text // col I
  colJ      String?  @db.Text // col J (Blank)
  colK      Decimal? @db.Decimal(19, 4) // BCA Shardjo
  colL      Decimal? @db.Decimal(19, 4) // BCA Juanda
  colM      Decimal? @db.Decimal(19, 4) // Mandiri Mid Plaza
  colN      Decimal? @db.Decimal(19, 4) // BTN
  colO      Decimal? @db.Decimal(19, 4) // BRI Shardjo
  colP      Decimal? @db.Decimal(19, 4) // BRI Tebet
  colQ      Decimal? @db.Decimal(19, 4) // Cash IDR
  colR      Decimal? @db.Decimal(19, 4) // Non CB 
  colS      Decimal? @db.Decimal(19, 4) // AP In and Out
  colT      String?  @db.Text // col T (Blank)
  colU      Decimal? @db.Decimal(19, 4) // OUTSTANDING IDR
  colV      Decimal? @db.Decimal(19, 4) // OUTSTANDING USD
  tagYear   Int
  /// Siapa yang menaruh baris ini: 'SEED' kalau dimuat dari workbook, 'APP'
  /// kalau diinput lewat aplikasi. Seeder hanya menghapus barisnya sendiri,
  /// jadi baris yang diketik orang selamat saat seed ulang tanpa perlu dicatat
  /// di mana pun. Defaultnya 'APP' dengan sengaja: kalau suatu seeder lupa
  /// menandai, akibatnya baris tertinggal - bukan baris user ikut terhapus.
  source            String    @default("APP")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  amounts AccountPayableAmount[]

  @@map("account_payables")
}

enum PpnType {
  WAPU
  NON_WAPU
}

enum DepreciationType {
  OFFICE_EQUIPMENT
  VEHICLE
  INTANGIBLE_ASSET
}

model TaxLedger {
  id        BigInt    @id @default(autoincrement())
  type      PpnType
  colA      DateTime? @db.Date // Masa
  colB      String?   @db.VarChar(100) // Faktur
  colC      String?   @db.VarChar(100) // No Faktur
  colD      String?   @db.Text // Client / Supplier
  colE      String?   @db.VarChar(255) // Reference
  colF      Int? // Sales (Year)
  colG      String?   @db.VarChar(100) // STATUS
  colH      Decimal?  @db.Decimal(19, 4) // PPN
  colI      Decimal?  @db.Decimal(19, 4) // Amount (WAPU/Non-WAPU)
  colJ      Decimal?  @db.Decimal(19, 4) // Masukan (WAPU/Non WAPU Paid)
  colK      Decimal?  @db.Decimal(19, 4) // Kurang Bayar (AP PPN WAPU)
  colL      String?   @db.VarChar(255) // Account
  colM      String?   @db.VarChar(255) // Sub Ledger 1
  colN      String?   @db.VarChar(255) // Sub Ledger 2
  colO      String?   @db.VarChar(255) // Sub Ledger 3
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("tax_ledgers")
}

// --- FINANCIAL DATA: ASSETS & DEPRECIATION ---

model Depreciation {
  id        BigInt           @id @default(autoincrement())
  colA      DateTime?        @map("col_a") // Date
  colB      String?          @map("col_b") @db.VarChar(100) // Bank Source
  colC      String?          @map("col_c") @db.Text // Description
  colD      Decimal?         @default(0) @map("col_d") @db.Decimal(19, 4) // Buy Price 
  colE      Int?             @map("col_e") // Month count (e.g, 36)
  colF      Decimal?         @default(0) @map("col_f") @db.Decimal(19, 4) // s/d 2024
  colG      Decimal?         @default(0) @map("col_g") @db.Decimal(19, 4) // Jan-25
  colH      Decimal?         @default(0) @map("col_h") @db.Decimal(19, 4) // Feb-25
  colI      Decimal?         @default(0) @map("col_i") @db.Decimal(19, 4) // Mar-25
  colJ      Decimal?         @default(0) @map("col_j") @db.Decimal(19, 4) // Apr-25
  colK      Decimal?         @default(0) @map("col_k") @db.Decimal(19, 4) // May-25
  colL      Decimal?         @default(0) @map("col_l") @db.Decimal(19, 4) // Jun-25
  colM      Decimal?         @default(0) @map("col_m") @db.Decimal(19, 4) // Jul-25
  colN      Decimal?         @default(0) @map("col_n") @db.Decimal(19, 4) // Aug-25
