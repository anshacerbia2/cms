  @@map("balance_sheet_items")
}


// --- FINANCIAL DATA: INTER-ACCOUNT TRANSFERS ---

model InterAccountTransfer {
  id          BigInt   @id @default(autoincrement())
  description String?  @db.VarChar(255)
  bca         Decimal  @default(0) @db.Decimal(19, 4)
  mandiri     Decimal  @default(0) @db.Decimal(19, 4)
  bri         Decimal  @default(0) @db.Decimal(19, 4)
